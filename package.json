{
  "name": "dsh-altare",
  "version": "1.0.0",
  "description": "把 Altare 云平台官方 API 接入 DeepSeek Harness：AI 用团队 API Token（alt_ 前缀）操作权限范围内的全部能力——应用、电源、部署、日志、文件、变量、备份、快照、域名与端口、Job、Schedule、团队与审计，并按 token scope 自动鉴权。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./runtime": "./lib/runtime.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "harness",
    "altare",
    "cloud",
    "hosting",
    "deploy",
    "devops",
    "api",
    "plugin-market"
  ],
  "license": "MIT",
  "author": "YG",
  "homepage": "https://docs.altare.gg/altare-api",
  "repository": {
    "type": "git",
    "url": "https://console.altare.gg/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
